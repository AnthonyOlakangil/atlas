# Atlas environment configuration.
# Copy to `.env` and fill in. NEVER commit `.env`.

# --- LLM (required for research cycles) ---
# Get a free key at https://aistudio.google.com — the operator pastes it here themselves.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash

# --- Mode: PAPER until the 30-day track-record gate passes ---
ATLAS_MODE=PAPER

# --- Database ---
ATLAS_DB_PATH=atlas.db

# --- Optional data sources ---
FRED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=atlas-research/0.1 (personal research agent)
YOUTUBE_API_KEY=

# --- Robinhood MCP ---
# Auth is an OAuth handshake completed in the browser; no password ever goes here.
RH_MCP_URL=https://agent.robinhood.com/mcp/trading
